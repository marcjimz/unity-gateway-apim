<!-- Flow #1 front door: the MCP server Databricks calls with each user's own Entra token.
     Only validates here; the token is passed to the Graph operations, which do the OBO exchange. -->
<policies>
    <inbound>
        <base />
        <include-fragment fragment-id="validate-user" />
        <include-fragment fragment-id="log-claims" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
        <choose>
            <when condition="@(context.Response.StatusCode == 401)">
                <set-header name="WWW-Authenticate" exists-action="override">
                    <value>Bearer realm="{{gateway-uri}}", scope="{{gateway-uri}}/mcp.invoke"</value>
                </set-header>
            </when>
        </choose>
    </on-error>
</policies>
